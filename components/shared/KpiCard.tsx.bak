'use client';

import { type LucideIcon } from 'lucide-react';

interface KpiCardProps {
  label: string;
  value: string;
  sub?: string;
  icon: LucideIcon;
  color?: 'cyan' | 'naranja' | 'green' | 'red' | 'purple';
  trend?: { value: number; label: string };
}

const COLOR_MAP = {
  cyan:    { bg: 'rgba(0,180,216,0.08)',   border: 'rgba(0,180,216,0.2)',   text: '#00B4D8',  iconBg: 'rgba(0,180,216,0.15)' },
  naranja: { bg: 'rgba(232,124,43,0.08)',  border: 'rgba(232,124,43,0.2)',  text: '#E87C2B',  iconBg: 'rgba(232,124,43,0.15)' },
  green:   { bg: 'rgba(34,197,94,0.08)',   border: 'rgba(34,197,94,0.2)',   text: '#22C55E',  iconBg: 'rgba(34,197,94,0.15)' },
  red:     { bg: 'rgba(239,68,68,0.08)',   border: 'rgba(239,68,68,0.2)',   text: '#EF4444',  iconBg: 'rgba(239,68,68,0.15)' },
  purple:  { bg: 'rgba(167,139,250,0.08)', border: 'rgba(167,139,250,0.2)', text: '#A78BFA',  iconBg: 'rgba(167,139,250,0.15)' },
};

export function KpiCard({ label, value, sub, icon: Icon, color = 'cyan', trend }: KpiCardProps) {
  const c = COLOR_MAP[color];

  return (
    <div
      className="rounded-xl p-4 flex flex-col gap-3 transition-all duration-200 hover:scale-[1.01]"
      style={{ backgroundColor: c.bg, border: `1px solid ${c.border}` }}
    >
      <div className="flex items-start justify-between">
        <div
          className="flex items-center justify-center rounded-lg p-2"
          style={{ backgroundColor: c.iconBg }}
        >
          <Icon size={18} style={{ color: c.text }} />
        </div>
        {trend && (
          <div
            className="text-[10px] font-medium px-2 py-0.5 rounded-full"
            style={{
              backgroundColor: trend.value >= 0 ? 'rgba(34,197,94,0.15)' : 'rgba(239,68,68,0.15)',
              color: trend.value >= 0 ? '#22C55E' : '#EF4444',
            }}
          >
            {trend.value >= 0 ? '▲' : '▼'} {Math.abs(trend.value)}% {trend.label}
          </div>
        )}
      </div>

      <div>
        <p className="font-orbitron font-bold text-xl leading-tight" style={{ color: c.text }}>
          {value}
        </p>
        <p className="text-xs font-medium mt-1" style={{ color: '#94A3B8' }}>{label}</p>
        {sub && <p className="text-[10px] mt-0.5" style={{ color: '#64748B' }}>{sub}</p>}
      </div>
    </div>
  );
}
